{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "PYTHONPATH=. uv run --no-project --with-requirements requirements.txt --python 3.14 scripts/init_ai_tables.py",
  "functions": {
    "api/index.py": { "maxDuration": 300 }
  },
  "rewrites": [
    { "source": "/api/:path*", "destination": "/api/index" }
  ]
}
