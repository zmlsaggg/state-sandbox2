# Required: external PostgreSQL, preferably a transaction-pooler URL with TLS.
DATABASE_URL=postgresql://USER:PASSWORD@POOLER_HOST:6543/postgres?sslmode=require
# Generate once with: python -c 'import secrets; print(secrets.token_urlsafe(48))'
# Keep the SAME value across deployments/instances; never expose to the browser.
JWT_SECRET_KEY=
FRONTEND_URL=https://your-frontend.vercel.app
# Only needed for direct cross-origin browser access; same-origin proxy needs none.
CORS_ORIGINS=http://localhost:3000
# Keep stream budget below Vercel maxDuration, lock TTL above maxDuration.
STREAM_TIMEOUT_SECONDS=280
TURN_LOCK_SECONDS=900
# Optional: required to enable email login and purchases, respectively.
POSTMARK_API_KEY=
EMAIL_FROM=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# AI credentials now belong to players; OPENAI_API_KEY is NOT used.
# One distributed limiter per authenticated game account:
AI_RATE_ACTIONS=12
AI_RATE_WINDOW_SECONDS=600
AI_COOLDOWN_SECONDS=8
# Must exceed the platform's hard function duration, not just stream timeout:
AI_ACTION_LEASE_SECONDS=330
# Limit internal concurrency without counting each model call as a game action:
AI_MAX_PARALLEL_CALLS=3
# Optional first deployment ONLY: creates missing game/AI tables and enables AI RLS.
# Requires table-owner privileges; turn off after bootstrap. Prefer the migration script.
INIT_DB_ON_STARTUP=false
